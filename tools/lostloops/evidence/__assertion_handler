// Census evidence rebuild only (corpus/census.py, index_evidence; corpus/PLAN2.md). It shadows
// the <__assertion_handler> header of libc++ through -I: every libc++ assertion becomes a call to
// a function that is never inlined and whose calls are never merged, so each check keeps its own
// source location and inline chain. In the normal FAST build the checks are __builtin_trap() and
// LLVM merges them into one ud2 per function whose location no longer says which check it was.
// The function is defined here (weak, in every translation unit) so that calls to it stay direct
// calls by name after the evidence object is linked. Never run.
#ifndef _LIBCPP___ASSERTION_HANDLER
#define _LIBCPP___ASSERTION_HANDLER

#include <__config>

extern "C" [[noreturn]] __attribute__((noinline, weak, used, nomerge)) void
__census_trap(const char*) noexcept {
  __builtin_trap();
}

#define _LIBCPP_ASSERTION_HANDLER(message) ::__census_trap(message)

#endif
